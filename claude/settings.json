{
  "cleanupPeriodDays": 365,
  "skillListingMaxDescChars": 3072,
  "skillListingBudgetFraction": 0.02,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "WebSearch",
      "Bash(ls:*)",
      "Bash(brew --version:*)",
      "Bash(brew install:*)",
      "Bash(git config:*)",
      "Bash(git clone:*)",
      "Bash(gh auth status:*)",
      "Bash(gh auth login:*)",
      "Bash(gh repo list:*)",
      "Bash(chmod:*)",
      "Bash(git init:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git branch:*)",
      "Bash(gh repo create:*)",
      "Bash(git push:*)",
      "Bash(ssh-copy-id:*)",
      "Bash(ssh-add:*)",
      "Bash(ssh:*)",
      "Bash(brew list:*)",
      "Bash(sshpass:*)",
      "Bash(echo:*)",
      "Bash(infocmp:*)",
      "Bash(scp:*)",
      "Bash(defaults read:*)",
      "Bash(defaults write:*)",
      "Bash(pgrep:*)",
      "Bash(ipconfig:*)",
      "Bash(xhost:*)",
      "Bash(DISPLAY=:0 xhost:*)",
      "Bash(DISPLAY=:0 /opt/X11/bin/xhost:*)",
      "Bash(lsof:*)",
      "Bash(killall:*)",
      "Bash(open:*)",
      "Bash(gh api:*)",
      "Bash(bash:*)",
      "Bash(tmux:*)",
      "Bash(ln:*)",
      "Bash(cat:*)",
      "Bash(~/project/scripts/docs-to-drive.sh:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/load-project-skills.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash $HOME/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "swift-lsp@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true,
    "everything-claude-code@everything-claude-code": true,
    "ui-ux-pro-max@ui-ux-pro-max-skill": true,
    "telegram@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true
  },
  "feedbackSurveyRate": 0,
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "awaySummaryEnabled": true,
  "showClearContextOnPlanAccept": true,
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "channelsEnabled": true,
  "autoDreamEnabled": true,
  "showThinkingSummaries": true,
  "skipDangerousModePermissionPrompt": true,
  "preferredNotifChannel": "kitty",
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true
}
