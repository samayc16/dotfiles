[user]
	name = Samay Chandna
	email = samay.chandna@gmail.com
[core]
	pager = delta
[alias]
	lg = log --oneline --graph --decorate --all
	st = status -sb
	co = checkout
	br = branch
	cm = commit -m
	amend = commit --amend --no-edit
	undo = reset --soft HEAD~1
	stash-all = stash push --include-untracked
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	syntax-theme = Monokai Extended
	line-numbers = true
	side-by-side = true
[merge]
	conflictstyle = diff3
[diff]
	colorMoved = default
