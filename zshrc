# Portable zshrc: macOS (Homebrew) and Linux (distro packages, mise, user-local clones).
# Machine-specific settings and secrets go in ~/.zshrc.local (sourced by zsh/common.zsh).

# The repo this file lives in (follows the ~/.zshrc symlink; an inherited DOTFILES may point elsewhere)
export DOTFILES="${${(%):-%N}:A:h}"

# A newer release asks once whether to update (zsh/update-check.zsh). It may read a key, so it
# sits above the instant prompt. Off in CI, without a terminal, or with DOTFILES_NO_UPDATE_CHECK=1.
if [[ -o interactive && -t 0 && -t 1 && -z ${CI-} && ${DOTFILES_NO_UPDATE_CHECK:-0} != 1 ]]; then
  source "$DOTFILES/zsh/update-check.zsh"
fi

# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# ── Platform ──────────────────────────────────────────────────────────
if [[ "$OSTYPE" == darwin* ]]; then
  if [[ -z "$HOMEBREW_PREFIX" ]]; then
    for _brew in /opt/homebrew/bin/brew /usr/local/bin/brew; do
      [[ -x $_brew ]] && eval "$($_brew shellenv zsh)" && break
    done
    unset _brew
  fi
  [[ -d /opt/homebrew/opt/trash/bin ]] && export PATH="/opt/homebrew/opt/trash/bin:$PATH"
  [[ -d /Applications/Utilities/XQuartz.app ]] && export DISPLAY=:0 # X11 apps via XQuartz
elif [[ -r /proc/version ]] && grep -qi microsoft /proc/version; then
  # WSL: start in $HOME rather than the Windows directory, use kitty terminfo if present
  [[ "$PWD" == /mnt/* ]] && cd ~
  infocmp xterm-kitty &>/dev/null && export TERM=xterm-kitty
fi

# ── Path ──────────────────────────────────────────────────────────────
export PATH="$HOME/.local/bin:$PATH"
# Swift on Linux (installed by swiftly)
[[ -r "$HOME/.local/share/swiftly/env.sh" ]] && source "$HOME/.local/share/swiftly/env.sh"
# Haskell on Linux (installed by ghcup)
[[ -d "$HOME/.ghcup/bin" ]] && export PATH="$HOME/.ghcup/bin:$HOME/.cabal/bin:$PATH"
# Rust: rustup (Homebrew's keg-only build on macOS) and `cargo install`ed tools
[[ -d "${HOMEBREW_PREFIX:-/opt/homebrew}/opt/rustup/bin" ]] && export PATH="${HOMEBREW_PREFIX:-/opt/homebrew}/opt/rustup/bin:$PATH"
[[ -d "$HOME/.cargo/bin" ]] && export PATH="$HOME/.cargo/bin:$PATH"

# Source the first readable file among the candidates (plugins live in different
# places: Homebrew, user-local clones from install.d/zsh.sh, distro packages).
_source_first() {
  local file
  for file in "$@"; do
    [[ -r "$file" ]] && { source "$file"; return 0; }
  done
  return 1
}

# Source a tool's generated shell init from a cache, instead of running the tool in every new shell:
#   _source_init <command> <file the init also depends on, or ''> <args…>
# The cache is rebuilt when the command resolves to another binary (an upgrade does that: Homebrew's
# Cellar and mise keep one directory per version), when the binary or that file is newer than the
# cache, or when the arguments change. Where it can't be written, the tool runs as usual.
_source_init() {
  local cmd=$1 dep=$2 exe=$commands[$1] bin cache stamp
  shift 2
  [[ -n $exe ]] || return 1
  bin=${exe:A} # the real file, for the stamp (run $exe itself: a mise shim needs its own name)
  cache=${XDG_CACHE_HOME:-$HOME/.cache}/zsh/init-$cmd.zsh
  [[ -r $cache ]] && read -r stamp <$cache
  if [[ $stamp != "# $bin $*" || $bin -nt $cache || ( -n $dep && $dep -nt $cache ) ]]; then
    if ! { mkdir -p ${cache:h} && { print -r -- "# $bin $*" && $exe "$@" } >|$cache.$$ &&
      mv -f -- $cache.$$ $cache } 2>/dev/null; then
      command rm -f -- $cache.$$ 2>/dev/null
      eval "$($exe "$@")"
      return
    fi
  fi
  source $cache
}

_zplug_dirs=(
  ${HOMEBREW_PREFIX:+$HOMEBREW_PREFIX/share}
  "$HOME/.local/share/zsh-plugins"
  /usr/share/zsh/plugins
  /usr/share
)

# ── Powerlevel10k ─────────────────────────────────────────────────────
_source_first \
  ${^_zplug_dirs}/powerlevel10k/powerlevel10k.zsh-theme \
  /usr/share/zsh-theme-powerlevel10k/powerlevel10k.zsh-theme \
  "$HOME/.local/share/powerlevel10k/powerlevel10k.zsh-theme"
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# ── History ───────────────────────────────────────────────────────────
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_SAVE_NO_DUPS
setopt HIST_REDUCE_BLANKS
setopt SHARE_HISTORY
setopt APPEND_HISTORY

# ── Completion ────────────────────────────────────────────────────────
# Our own (learn, play, tools) + ones generated by the installer on Linux.
fpath=("$DOTFILES/zsh/completions" "$HOME/.local/share/zsh/site-functions" $fpath)
autoload -Uz compinit && compinit
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'
zstyle ':completion:*' menu select
zstyle ':completion:*:descriptions' format '[%d]' # group headers (fzf-tab shows them)

# ── Key bindings ──────────────────────────────────────────────────────
bindkey -e
bindkey '^[[A' history-search-backward
bindkey '^[[B' history-search-forward
bindkey '^[[Z' autosuggest-accept
bindkey '^[[1;3D' backward-word
bindkey '^[[1;3C' forward-word
bindkey '^[b' backward-word
bindkey '^[f' forward-word

# ── Functions ────────────────────────────────────────────────────
mkcd() { mkdir -p "$1" && cd "$1" }

# yazi's shell wrapper: `y` browses files and, when you quit with q, leaves the shell in the
# directory you were in (Q quits without moving).
function y() {
  local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
  command yazi "$@" --cwd-file="$tmp"
  IFS= read -r -d '' cwd < "$tmp"
  [ "$cwd" != "$PWD" ] && [ -d "$cwd" ] && builtin cd -- "$cwd"
  command rm -f -- "$tmp"
}

# ── Aliases ───────────────────────────────────────────────────────────
# Debian/Ubuntu name some tools differently
(( $+commands[batcat] && ! $+commands[bat] )) && alias bat='batcat'
(( $+commands[fdfind] && ! $+commands[fd] )) && alias fd='fdfind'

if (( $+commands[eza] )); then
  alias ls='eza --icons --group-directories-first'
  alias ll='eza -la --icons --group-directories-first'
  alias lt='eza --tree --icons --level=2'
else
  alias ls='ls --color=auto'
  alias ll='ls -la'
fi
(( $+commands[bat] || $+commands[batcat] )) && alias cat='bat --paging=never'
(( $+commands[nvim] )) && alias vim='nvim' vi='nvim'
# rm → trash when available (macOS `trash`, Linux trash-cli), otherwise ask first
if (( $+commands[trash] )); then
  alias rm='trash'
elif (( $+commands[trash-put] )); then
  alias rm='trash-put'
else
  alias rm='rm -i'
fi
(( $+commands[kitten] )) && alias img='kitten icat'
# In a kitty window, ssh carries kitty's terminfo and shell integration to the remote host. Not
# inside tmux: kitty's docs say the ssh kitten may not work under a multiplexer (and the window id
# can be stale there). Plain ssh everywhere else.
if [[ ( $TERM == xterm-kitty || -n $KITTY_WINDOW_ID ) && -z $TMUX ]] && (( $+commands[kitten] )); then
  alias ssh='kitten ssh'
fi
alias lg='lazygit'
alias c='clear'
alias 1='cd ..'
alias 2='cd ../..'
alias 3='cd ../../..'
alias 4='cd ../../../..'
alias 5='cd ../../../../..'

# ── Environment ───────────────────────────────────────────────────────
if (( $+commands[nvim] )); then
  export EDITOR='nvim' VISUAL='nvim'
else
  export EDITOR='vi' VISUAL='vi'
fi
export BAT_THEME='Monokai Extended'
(( $+commands[bat] )) && export MANPAGER="sh -c 'col -bx | bat -l man -p'"

# ── Mise (runtime version manager; provides the CLI tools on Linux) ──
if (( $+commands[mise] )); then
  eval "$(mise activate zsh)"
elif [[ -x "$HOME/.local/bin/mise" ]]; then
  eval "$("$HOME/.local/bin/mise" activate zsh)"
fi

# ── fzf ───────────────────────────────────────────────────────────────
if (( $+commands[fzf] )); then
  # atuin takes Ctrl-R (below); an empty FZF_CTRL_R_COMMAND makes fzf skip binding it. Ctrl-T and
  # Alt-C stay fzf's.
  (( $+commands[atuin] )) && FZF_CTRL_R_COMMAND=
  source <(fzf --zsh)
  export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
  export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
  export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git'
  export FZF_DEFAULT_OPTS='
    --color=fg:#f8f8f2,bg:#272822,hl:#f92672
    --color=fg+:#f8f8f2,bg+:#49483e,hl+:#f92672
    --color=info:#a6e22e,prompt:#f92672,pointer:#66d9ef
    --color=marker:#a6e22e,spinner:#ae81ff,header:#75715e
    --height=40% --layout=reverse --border'
fi

# ── fzf-tab: Tab opens a fuzzy, previewed menu (after compinit + fzf, before
#    plugins that wrap widgets). `<` / `>` switch groups.
if (( $+commands[fzf] )) && _source_first ${^_zplug_dirs}/fzf-tab/fzf-tab.zsh; then
  zstyle ':completion:*' menu no
  zstyle ':fzf-tab:*' switch-group '<' '>'
  zstyle ':fzf-tab:complete:cd:*' fzf-preview 'eza -1 --color=always --icons $realpath'
  zstyle ':fzf-tab:complete:(-command-|tools|tldr|man):*' fzf-preview 'tldr -C $word 2>/dev/null || man $word 2>/dev/null | col -bx'
fi

# ── Zoxide powers cd (must be after compinit) ────────────────────────
# Real paths work as always; `cd dot` jumps to the best-ranked match (~/dotfiles) and
# `cdi` picks interactively. z / zi stay as aliases.
if (( $+commands[zoxide] )); then
  eval "$(zoxide init zsh --cmd cd)"
  alias z=cd zi=cdi
fi

# ── atuin: Ctrl-R searches every shell's history (local only: atuin/config.toml) ──
# After fzf, so Ctrl-R is atuin's whatever fzf did. The up arrow stays zsh's prefix search, and
# autosuggestions keep reading zsh's history: atuin's strategy runs `atuin search` per keystroke.
if (( $+commands[atuin] )); then
  # atuin's init runs `atuin uuid` for this shell's session id unless one is set; making the same
  # UUIDv7 here (48-bit ms clock, version 7, variant 10, random bits) saves that process per shell.
  () {
    [[ -n $ATUIN_SESSION && $ATUIN_SHLVL == $SHLVL ]] && return
    zmodload -F zsh/datetime p:EPOCHREALTIME 2>/dev/null || return
    local -i ms=$(( EPOCHREALTIME * 1000 ))
    printf -v ATUIN_SESSION '%012x7%03x%x%03x%04x%04x%04x' $ms $(( RANDOM & 0xfff )) \
      $(( 8 | (RANDOM & 3) )) $(( RANDOM & 0xfff )) $RANDOM $RANDOM $(( ($$ ^ RANDOM) & 0xffff ))
    export ATUIN_SESSION ATUIN_SHLVL=$SHLVL
  }
  _source_init atuin "$HOME/.atuin/config.toml" init zsh --disable-up-arrow
  ZSH_AUTOSUGGEST_STRATEGY=(history)
fi

# ── direnv: per-directory environments from .envrc (`direnv allow` once per file) ──
(( $+commands[direnv] )) && _source_init direnv '' hook zsh

# ── Git delta ─────────────────────────────────────────────────────────
# Delta is configured via ~/.gitconfig (see git config setup)

# ── Shared config (keybindings, colors, helpers) ─────────────────────
source "$DOTFILES/zsh/common.zsh"

# ── Plugins (keep at end; syntax highlighting last) ──────────────────
_source_first ${^_zplug_dirs}/zsh-autosuggestions/zsh-autosuggestions.zsh
_source_first ${^_zplug_dirs}/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
unset _zplug_dirs

# ── OpenClaw ─────────────────────────────────────────────────────────
[[ -f "$HOME/.openclaw/completions/openclaw.zsh" ]] && source "$HOME/.openclaw/completions/openclaw.zsh"

# ── Antigravity ──────────────────────────────────────────────────────
[[ -d "$HOME/.antigravity/antigravity/bin" ]] && export PATH="$HOME/.antigravity/antigravity/bin:$PATH"

# Keep the last status 0 so the first prompt isn't shown as an error
true
