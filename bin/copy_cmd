#!/usr/bin/env bash
# Copy text to the clipboard without running it (no streaming, no execution).
# Usage: copy_cmd echo "hello"     -> copies "echo hello"
#        echo "hello" | copy_cmd   -> copies "hello"
#
# Thin wrapper over `copy` (OSC52 + native clipboard), which prints the text
# and copies it without the trailing newline.

if [ $# -gt 0 ]; then
    cmd="$*"
else
    cmd=$(cat)
fi

copy="$(dirname "$0")/copy"
[ -x "$copy" ] || copy=$(command -v copy) || { echo "copy_cmd: 'copy' not found" >&2; exit 1; }

printf '%s\n' "$cmd" | "$copy"
