#!/usr/bin/env bash
# cheat: the keys and commands this setup gives you, one app at a time.
#
#   cheat                 search every key of every app as you type (fzf); lists the apps without fzf
#   cheat <app>           that app's sheet: cheat tmux, cheat nvim, cheat shell, cheat tamp, …
#   cheat <words>         every key that mentions all the words, in any app: cheat split
#   cheat <app> <words>   the same in one app: cheat tmux session
#   cheat --list          the apps
#
# The sheets are cheatsheets/*.md in the dotfiles repo (CHEATSHEET.md has them all on one page).
# NO_COLOR=1 turns colour off.
# Bash 3.2 (macOS) compatible.
set -euo pipefail

resolve() { # follow symlinks by hand: macOS before 12.3 has no `readlink -f`
  local path="$1" target
  while [[ -L "$path" ]]; do
    target="$(readlink "$path")"
    case "$target" in /*) path="$target" ;; *) path="$(dirname "$path")/$target" ;; esac
  done
  printf '%s/%s\n' "$(cd "$(dirname "$path")" && pwd -P)" "$(basename "$path")"
}
SELF="$(resolve "${BASH_SOURCE[0]}")"
SHEETS="${CHEAT_DIR:-$(dirname "$(dirname "$SELF")")/cheatsheets}"

die() { printf 'cheat: %s\n' "$1" >&2; exit "${2:-1}"; }
usage() { sed -n '2,/^# Bash 3.2/{s/^# \{0,1\}//;p;}' "$SELF" | sed '$d'; }

[[ -d "$SHEETS" ]] || die "no cheatsheets at $SHEETS"

COLOR=0
[[ -t 1 && -z "${NO_COLOR:-}" ]] && COLOR=1

apps() { local f; for f in "$SHEETS"/*.md; do [[ -f "$f" ]] && basename "$f" .md; done; }
title() { sed -n 's/^# //p' "$SHEETS/$1.md" | head -n 1 | tr -d '`'; }

# The names people reach for first.
canonical() {
  case "$1" in
    nvim | vim | vi) echo neovim ;;
    zsh | bash | terminal) echo shell ;;
    music | plexamp | plexamp-tui) echo tamp ;;
    install | update | dotfile) echo dotfiles ;;
    claude-code | cc) echo claude ;;
    lazygit | lg) echo git ;;
    dojo | play | games) echo learn ;;
    *) echo "$1" ;;
  esac
}

# Markdown in, terminal text out. Run under LC_ALL=C so every awk counts bytes the same way;
# display width = bytes minus UTF-8 continuation bytes.
#   mode=page  the sheet laid out for reading: headings, aligned key columns, prose
#   mode=rows  one line per key: app TAB section TAB keys TAB does (and prose, with empty keys)
render() { # mode file app
  LC_ALL=C awk -v mode="$1" -v app="$3" -v color="$COLOR" '
    function width(s,  t) { t = s; gsub(/[\200-\277]/, "", t); return length(t) }
    function trim(s) { sub(/^[ \t]+/, "", s); sub(/[ \t]+$/, "", s); return s }
    function delink(s,  out, i, k, rest, c) { # [text](target) → text
      out = ""
      while ((i = index(s, "](")) > 0) {
        for (k = i - 1; k > 0 && substr(s, k, 1) != "["; k--) {}
        rest = substr(s, i + 2); c = index(rest, ")")
        if (k == 0 || c == 0) break
        out = out substr(s, 1, k - 1) substr(s, k + 1, i - k - 1)
        s = substr(rest, c + 1)
      }
      return out s
    }
    function clean(s) { gsub(/\*\*/, "", s); gsub(/`/, "", s); s = delink(s); gsub(/\001/, "|", s); return trim(s) }
    function paint(code, s) { return color ? "\033[" code "m" s "\033[0m" : s }
    function pad(s, n,  out) { out = s; n -= width(s); while (n-- > 0) out = out " "; return out }
    function flush(  i, w, widest) {
      if (rows == 0) return
      widest = 0
      for (i = 1; i <= rows; i++) { w = width(key[i]); if (w > widest && w <= 30) widest = w }
      for (i = 1; i <= rows; i++) {
        if (key[i] == "") { print "  " what[i]; continue }
        if (width(key[i]) > widest) { print "  " paint("38;2;255;216;102", key[i]); print "  " pad("", widest) "  " what[i] }
        else print "  " paint("38;2;255;216;102", pad(key[i], widest)) "  " what[i]
      }
      rows = 0
    }
    function emit(k, d) {
      if (mode == "rows") { printf "%s\t%s\t%s\t%s\n", app, section, k, d; return }
      rows++; key[rows] = k; what[rows] = d
    }
    BEGIN { section = ""; intable = 0; rows = 0; blank = 1 }
    /^[ \t]*(```|~~~)/ { flush(); fenced = !fenced; next }
    fenced { if (mode == "page") { print "    " paint("38;2;114;112;114", $0); blank = 0 }; next }
    /^<!--/ || /^!\[/ { next }
    /^#+ / {
      flush(); intable = 0
      level = index($0, " ") - 1; text = clean(substr($0, level + 2))
      if (level > 1) section = text
      if (mode == "page") {
        if (!blank) print ""
        print paint(level == 1 ? "1;38;2;255;97;136" : "1;38;2;120;220;232", text)
        blank = 0
      }
      next
    }
    /^\|/ {
      line = $0; gsub(/\\\|/, "\001", line)
      n = split(line, cell, "|")
      if (!intable) { intable = 1; cols = n; for (i = 2; i < n; i++) head[i] = clean(cell[i]); next }
      if (line ~ /^\|[-:| \t]+\|[ \t]*$/) next
      k = clean(cell[2]); d = ""
      for (i = 3; i < n; i++) {
        v = clean(cell[i]); if (v == "") continue
        if (n > 4) v = head[i] ": " v   # wide tables: say which column each value is
        d = d (d == "" ? "" : " · ") v
      }
      emit(k, d); blank = 0
      next
    }
    { intable = 0 }
    /^---[ \t]*$/ { next }
    /^[ \t]*$/ { flush(); if (mode == "page" && !blank) { print ""; blank = 1 }; next }
    { text = clean($0); if (mode == "rows") emit("", text); else { flush(); print text; blank = 0 } }
    END { flush() }
  ' "$2"
}

all_rows() { local app; for app in "$@"; do render rows "$SHEETS/$app.md" "$app"; done; }

# rows on stdin → aligned "app  keys  does" lines
format_rows() {
  LC_ALL=C awk -F '\t' -v color="$COLOR" '
    function width(s,  t) { t = s; gsub(/[\200-\277]/, "", t); return length(t) }
    function paint(code, s) { return color ? "\033[" code "m" s "\033[0m" : s }
    function pad(s, n,  out) { out = s; n -= width(s); while (n-- > 0) out = out " "; return out }
    { n++; a[n] = $1; k[n] = $3; d[n] = $4; if (width($1) > wa) wa = width($1); if (width($3) > wk && width($3) <= 30) wk = width($3) }
    END {
      for (i = 1; i <= n; i++) {
        lead = paint("38;2;114;112;114", pad(a[i], wa)) "  "
        if (k[i] == "") print lead pad("", wk) "  " d[i]
        else if (width(k[i]) > wk) print lead paint("38;2;255;216;102", k[i]) "  " d[i]
        else print lead paint("38;2;255;216;102", pad(k[i], wk)) "  " d[i]
      }
    }'
}

# rows on stdin whose text has every word (any case, taken literally)
matching() {
  LC_ALL=C awk -F '\t' -v words="$*" '
    BEGIN { n = split(tolower(words), want, " ") }
    { text = tolower($2 " " $3 " " $4); for (i = 1; i <= n; i++) if (!index(text, want[i])) next; print }'
}

show() { # app
  if [[ -t 1 ]] && command -v less >/dev/null; then
    render page "$SHEETS/$1.md" "$1" | less -FRX
  else
    render page "$SHEETS/$1.md" "$1"
  fi
}

search() { # words… (CHEAT_IN: limit to these apps)
  local found
  # shellcheck disable=SC2086 # CHEAT_IN is a space-separated list of app names
  found="$(all_rows $CHEAT_IN | matching "$@")"
  [[ -n "$found" ]] || die "nothing mentions '$*' (cheat --list shows the apps)"
  printf '%s\n' "$found" | format_rows
}

list() {
  local app
  if [[ "${1:-}" == complete ]]; then
    for app in $(apps); do printf '%s:%s\n' "$app" "$(title "$app")"; done
  else
    for app in $(apps); do printf '  %-10s %s\n' "$app" "$(title "$app")"; done
    printf '\ncheat <app> shows one, cheat <words> searches them all.\n'
  fi
}

interactive() {
  local picked
  # shellcheck disable=SC2046 # one argument per app
  picked="$(all_rows $(apps) | format_rows | fzf --ansi --multi --no-sort --height=80% --reverse \
    --prompt='cheat> ' --header='type to search every key · Tab picks several · Enter prints them')" || exit 0
  printf '%s\n' "$picked"
}

case "${1:-}" in
  -h | --help) usage; exit 0 ;;
  -l | --list) list; exit 0 ;;
  --complete) list complete; exit 0 ;;
  -*) usage >&2; exit 2 ;;
  "")
    if [[ -t 0 && -t 1 ]] && command -v fzf >/dev/null; then interactive; else list; fi
    exit 0 ;;
esac

app="$(canonical "$1")"
if [[ -f "$SHEETS/$app.md" ]]; then
  shift
  if [[ $# -eq 0 ]]; then show "$app"; else CHEAT_IN="$app" search "$@"; fi
else
  CHEAT_IN="$(apps | tr '\n' ' ')" search "$@"
fi
